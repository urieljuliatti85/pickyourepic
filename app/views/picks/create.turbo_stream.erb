<%# Troca botao, contagem e lista de quem pickou — todas as aparicoes deste
    Epic na pagina. O mesmo conteudo serve create e destroy: os dois so
    alternam o estado.

    `replace` em frame que nao existe na pagina atual e no-op, entao um mesmo
    template serve o Discover (so botao + contagem) e a pagina do Epic (que
    tem tambem a lista). %>
<%= turbo_stream.replace dom_id(@epic, :pick_button) do %>
  <%= render "shared/pick_button", epic: @epic %>
<% end %>

<%= turbo_stream.replace dom_id(@epic, :pick_count) do %>
  <%= render "shared/pick_count", epic: @epic %>
<% end %>

<%= turbo_stream.replace dom_id(@epic, :pickers) do %>
  <%= render "shared/pickers", epic: @epic, picks: @picks %>
<% end %>

<%= turbo_stream.update "flash" do %>
  <%= render "shared/flash" %>
<% end %>
