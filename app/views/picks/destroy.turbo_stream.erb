<%# Swaps button, count and the list of who picked — every appearance of this
    Epic on the page. The same content serves create and destroy: the two only
    toggle the state.

    A `replace` on a frame absent from the current page is a no-op, so one
    template serves Discover (button + count only) and the Epic page (which also
    has the list).
    
    UX: Append toast notification before updating components. %>
<%= turbo_stream.append "toasts-container" do %>
  <%= render ToastComponent.new(type: :success, message: "Epic unpicked. 🎵") %>
<% end %>

<%= turbo_stream.replace dom_id(@epic, :pick_button) do %>
  <%= render "shared/pick_button", epic: @epic %>
<% end %>

<%= turbo_stream.replace dom_id(@epic, :pick_count) do %>
  <%= render "shared/pick_count", epic: @epic %>
<% end %>

<%= turbo_stream.replace dom_id(@epic, :pickers) do %>
  <%= render "shared/pickers", epic: @epic, picks: @picks %>
<% end %>

<%= turbo_stream.update "flash" do %>
  <%= render "shared/flash" %>
<% end %>
