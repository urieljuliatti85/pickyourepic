<%# The same layout as Create Epic (the Spotify hero reference): a teal->indigo
    gradient, a large title, soft secondary copy and pill buttons. The tokens
    (ink, lime-accent) are the same as the rest of the app. %>
<div class="mx-auto max-w-2xl px-4 py-8">

  <div class="overflow-hidden rounded-3xl border border-white/10 bg-ink-soft shadow-2xl shadow-black/30">

    <div class="bg-gradient-to-br from-lime-accent/30 via-lime-accent/10 to-indigo-500/20 px-6 py-8 sm:px-10 sm:py-10">
      <%# Artwork beside the title, not as a banner: `Spotify::Search` keeps
          the SMALLEST album image (~64px), which would blur if stretched. %>
      <div class="flex items-start gap-5">
        <% if @epic.track.album_artwork_url.present? %>
          <%= image_tag @epic.track.album_artwork_url, alt: "",
                class: "h-24 w-24 flex-none rounded-2xl object-cover shadow-lg shadow-black/40 sm:h-28 sm:w-28" %>
        <% else %>
          <div class="h-24 w-24 flex-none rounded-2xl bg-white/5 sm:h-28 sm:w-28"></div>
        <% end %>

        <div class="min-w-0">
          <h1 class="text-3xl font-bold tracking-tight text-neutral-50 sm:text-4xl">
            <%= @epic.title %>
          </h1>

          <p class="mt-2 max-w-lg text-sm leading-relaxed text-neutral-300 sm:text-base">
            <strong class="font-semibold text-neutral-100"><%= @epic.track.name %></strong>
            · <%= @epic.track.artist_name %>
          </p>

          <% if @epic.track.album_name.present? %>
            <p class="mt-0.5 truncate text-xs text-neutral-400"><%= @epic.track.album_name %></p>
          <% end %>

          <% if @epic.description.present? %>
            <p class="mt-1 max-w-lg text-sm leading-relaxed text-neutral-400">
              <%= @epic.description %>
            </p>
          <% end %>
        </div>
      </div>

      <%# Play and Pick side by side, like the reference's PLAY / FOLLOW. %>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <%= render "shared/epic_play_button", epic: @epic %>

        <%# The partial already covers "not my Epic" and "one Pick per user";
            visibility_public? is this page's extra rule, since it shows a
            private Epic to its owner. %>
        <% if @epic.visibility_public? %>
          <%= render "shared/pick_button", epic: @epic %>
        <% end %>

        <%= render "shared/favorite_button", epic: @epic %>

        <%# Deleting is irreversible and takes the Picks the Epic received with
            it, so the turbo_confirm says what is lost rather than a bare
            "are you sure?". %>
        <% if current_user == @epic.user %>
          <%= button_to "Delete", epic_path(@epic), method: :delete,
                form: { class: "inline-block" },
                data: { turbo_confirm: "Excluir \"#{@epic.title}\"? Os Picks que ele recebeu se perdem." },
                class: "rounded-full border border-red-500/40 px-4 py-2 text-sm font-semibold text-red-300 hover:bg-red-500/10" %>
        <% end %>
      </div>
    </div>

    <div class="px-6 py-8 sm:px-10">

      <%# The excerpt: an Epic's central piece of information. %>
      <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
        <p class="text-xs font-semibold uppercase tracking-wider text-neutral-400">Excerpt</p>

        <p class="mt-2 text-2xl font-semibold tabular-nums text-neutral-50">
          <%= number_to_duration(@epic.start_time) %>
          <span class="text-neutral-500">–</span>
          <%= number_to_duration(@epic.end_time) %>
        </p>

        <p class="mt-1 text-sm text-neutral-400">
          <%= number_to_duration(@epic.end_time - @epic.start_time) %> de
          <%= number_to_duration(@epic.track.duration_ms) %>
        </p>
      </div>

      <dl class="mt-4 grid gap-3 sm:grid-cols-2">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
          <dt class="text-xs font-semibold uppercase tracking-wider text-neutral-400">Criado por</dt>
          <dd class="mt-1">
            <%= link_to "@#{@epic.user.username}", profile_path(@epic.user),
                  class: "text-sm font-medium text-neutral-100 hover:text-lime-accent" %>
          </dd>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
          <dt class="text-xs font-semibold uppercase tracking-wider text-neutral-400">Visibilidade</dt>
          <dd class="mt-1">
            <% if @epic.visibility_public? %>
              <span class="rounded-full bg-lime-accent/15 px-3 py-1 text-xs font-semibold text-lime-accent">Public</span>
            <% else %>
              <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-neutral-300">Private</span>
            <% end %>
          </dd>
        </div>
      </dl>

      <div class="mt-4 rounded-2xl border border-white/10 bg-white/5 p-5">
        <%= render "shared/pickers", epic: @epic, picks: @picks %>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <%= link_to "Back", tracks_path,
              class: "rounded-full border border-lime-accent/60 px-8 py-2.5 text-sm font-semibold uppercase tracking-wide text-lime-accent hover:bg-lime-accent/10" %>
      </div>
    </div>
  </div>
</div>
