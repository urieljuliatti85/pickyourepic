<%# Partial: Play button para um Epic usando Spotify Web Playback SDK.
    Requer: epic (Epic), e current_user autenticado com Premium.
    O SDK é 100% client-side (CLAUDE.md § Architecture — Playback). %>

<% if current_user&.spotify_account&.premium? %>
  <div data-controller="playback"
       data-playback-spotify-uri-value="spotify:track:<%= epic.track.spotify_id %>"
       data-playback-start-time-value="<%= epic.start_time %>"
       data-playback-end-time-value="<%= epic.end_time %>"
       data-playback-token-url-value="<%= api_playback_token_path %>"
       class="inline-flex items-center gap-2">
    <button data-action="click->playback#play"
            data-playback-target="button"
            class="rounded-full border border-white/15 px-4 py-1.5 text-sm font-medium text-neutral-200 hover:border-lime-accent hover:text-lime-accent">
      ▶ Play
    </button>
    <span data-playback-target="status"
          class="text-xs text-neutral-500"></span>
  </div>
<% elsif current_user %>
  <p class="text-xs text-neutral-500">
    <em>Spotify Premium required for playback.</em>
  </p>
<% end %>
