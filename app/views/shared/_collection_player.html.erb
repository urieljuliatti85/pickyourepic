<%# A Collection's play button. Like an Epic's, it does not instantiate the SDK:
    it dispatches the queue to the global bar (shared/_player_bar), which holds
    the device and survives navigation.

    This partial used to carry its own controller with a separate device —
    leaving the page killed the sound, and two devices fought over playback. %>

<% if current_user&.spotify_account&.premium? && collection.collection_epics.any? %>
  <%
    queue = collection.collection_epics.includes(epic: :track).map do |ce|
      {
        uri: "spotify:track:#{ce.epic.track.spotify_id}",
        startTime: ce.epic.start_time,
        endTime: ce.epic.end_time,
        title: ce.epic.title,
        subtitle: "#{ce.epic.track.artist_name} · #{ce.epic.track.name}",
        artwork: ce.epic.track.album_artwork_url
      }
    end
  %>

  <button type="button"
          class="inline-flex items-center gap-2 rounded-full bg-lime-accent px-8 py-2.5 text-sm font-semibold uppercase tracking-wide text-neutral-950 hover:bg-lime-bright"
          data-controller="play-request"
          data-play-request-queue-value="<%= queue.to_json %>"
          data-action="play-request#playQueue">
    <span aria-hidden="true">▶</span> Play Collection
  </button>

<% elsif current_user&.spotify_account&.premium? %>
  <%# With no Epics there is nothing to play; a dead button would only confuse. %>
<% elsif current_user %>
  <p class="text-xs text-neutral-500">
    <em>Spotify Premium is required to play.</em>
  </p>
<% else %>
  <%= button_to "Sign in to listen", auth_spotify_path,
        form: { data: { turbo: false } },
        class: "inline-flex items-center gap-2 rounded-full bg-lime-accent px-8 py-2.5 text-sm font-semibold uppercase tracking-wide text-neutral-950 hover:bg-lime-bright" %>
<% end %>
