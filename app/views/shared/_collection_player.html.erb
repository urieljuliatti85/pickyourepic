<%# Partial: Play Collection button (reprodução sequencial de Epics).
    Requer: collection (Collection), e current_user autenticado com Premium.
    Dados: JSON array de epics com spotifyUri, startTime, endTime, title. %>

<% if current_user&.spotify_account&.premium? && collection.collection_epics.any? %>
  <%
    epics_data = collection.collection_epics.includes(epic: :track).map do |ce|
      {
        spotifyUri: "spotify:track:#{ce.epic.track.spotify_id}",
        startTime: ce.epic.start_time,
        endTime: ce.epic.end_time,
        title: ce.epic.title
      }
    end
  %>
  <div data-controller="collection-playback"
       data-collection-playback-epics-value="<%= epics_data.to_json %>"
       data-collection-playback-token-url-value="<%= api_playback_token_path %>"
       class="p-4 bg-purple-50 border border-purple-200 rounded">
    <div class="flex items-center gap-3">
      <button data-action="click->collection-playback#play"
              data-collection-playback-target="button"
              class="px-4 py-2 bg-purple-500 text-white rounded hover:bg-purple-600 text-sm font-medium">
        ▶ Play Collection
      </button>
      <button data-action="click->collection-playback#next"
              class="px-3 py-2 bg-purple-300 text-purple-800 rounded hover:bg-purple-400 text-sm">
        ⏭ Next
      </button>
      <span data-collection-playback-target="status"
            class="text-xs text-gray-500"></span>
    </div>
    <p data-collection-playback-target="current"
       class="text-sm text-purple-700 mt-2 font-medium"></p>
  </div>
<% elsif current_user %>
  <p class="text-xs text-gray-500">
    <em>Spotify Premium required for playback.</em>
  </p>
<% end %>
