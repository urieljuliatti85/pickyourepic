<%# The count and the list of who picked an Epic. In a frame of its own because
    one Pick changes both at once (shared/_pick_count covers the places where only
    the count appears).

    Private profiles are listed: visibility governs content, not whether a
    username may be listed (docs/product.md § Who Picked an Epic).

    target: "_top" because the frame exists only to be a turbo_stream target —
    without it, clicking a picker's name would load the profile INSIDE the frame
    instead of navigating. %>
<%= turbo_frame_tag dom_id(epic, :pickers), target: "_top" do %>
  <p class="text-xs font-semibold uppercase tracking-wider text-neutral-400">
    <%= pluralize(picks.size, "Pick") %>
  </p>

  <% if picks.any? %>
    <ul class="mt-3 flex flex-wrap gap-2">
      <% picks.each do |pick| %>
        <li>
          <%= link_to "@#{pick.user.username}", profile_path(pick.user),
                class: "inline-block rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-neutral-300 hover:border-lime-accent/50 hover:text-neutral-100" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-2 text-sm text-neutral-500">Nobody has picked this Epic yet.</p>
  <% end %>
<% end %>
