<%# Player bar pinned to the bottom.

    The reference's layout: artwork + title/artist on the left, transport
    (previous / play / next) in the middle, elapsed time, a draggable progress bar
    and total time, and volume on the right.

    It lives inside a `permanent` turbo-frame: Turbo reuses this same element
    across navigations instead of recreating it, so the SDK device survives and
    the music does not stop when the page changes.

    It only appears for someone who can play (Premium); it starts hidden and
    reveals itself on the first play. %>
<% if current_user&.spotify_account&.premium? %>
  <%# `turbo-permanent` and `data-controller` must sit on THE SAME element
      (and it needs an id): Turbo only preserves the marked node. With the
      controller on a child, every navigation — the redirect after creating an
      Epic, for instance — recreated the element, disconnect() tore down the SDK
      device and the next play spun forever without sound. %>
  <%= turbo_frame_tag "player_bar" do %>
    <div id="player_bar_shell" data-turbo-permanent
         class="hidden fixed inset-x-0 bottom-0 z-30 border-t border-white/10 bg-ink-rail/95 backdrop-blur"
         data-controller="player-bar"
         data-player-bar-token-url-value="<%= api_playback_token_path %>">
      <div class="mx-auto flex max-w-7xl items-center gap-4 px-4 py-3 sm:px-6">

        <%# Current track: artwork, title, artist. %>
        <div class="flex min-w-0 flex-1 items-center gap-3 sm:w-64 sm:flex-none">
          <img data-player-bar-target="artwork" hidden alt=""
               class="h-11 w-11 flex-none rounded object-cover">

          <div class="min-w-0">
            <p class="truncate text-sm font-semibold" data-player-bar-target="title">—</p>
            <p class="truncate text-xs text-neutral-400" data-player-bar-target="subtitle"></p>
          </div>
        </div>

        <%# Transport. `disabled:opacity-30` because with a lone Epic there is
            nowhere to skip to. %>
        <div class="flex flex-none items-center gap-2 sm:gap-3">
          <button type="button" aria-label="Previous"
                  data-player-bar-target="prev"
                  data-action="player-bar#previous"
                  class="flex h-8 w-8 items-center justify-center rounded-full text-neutral-400 hover:text-neutral-100 disabled:opacity-30 disabled:hover:text-neutral-400">
            ⏮
          </button>

          <button type="button" aria-label="Play or pause"
                  data-player-bar-target="button"
                  data-action="player-bar#toggle"
                  class="flex h-10 w-10 items-center justify-center rounded-full border border-white/20 text-lg hover:border-lime-accent hover:text-lime-accent">
            ▶
          </button>

          <button type="button" aria-label="Next"
                  data-player-bar-target="next"
                  data-action="player-bar#next"
                  class="flex h-8 w-8 items-center justify-center rounded-full text-neutral-400 hover:text-neutral-100 disabled:opacity-30 disabled:hover:text-neutral-400">
            ⏭
          </button>

          <span class="w-8 text-xs tabular-nums text-neutral-500"
                data-player-bar-target="queuePosition"></span>
        </div>

        <%# Progress: a real range on top of the painted track, so the excerpt
            is draggable with a keyboard and a screen reader, not just a mouse. %>
        <div class="hidden flex-1 items-center gap-3 sm:flex">
          <span class="w-10 text-right text-xs tabular-nums text-neutral-400"
                data-player-bar-target="elapsed">0:00</span>

          <div class="relative flex-1">
            <div class="h-1 w-full overflow-hidden rounded-full bg-white/10">
              <div class="h-full w-0 rounded-full bg-lime-accent"
                   data-player-bar-target="progress"></div>
            </div>

            <input type="range" min="0" max="100" value="0" step="0.1"
                   aria-label="Position in the excerpt"
                   data-player-bar-target="scrubber"
                   data-action="input->player-bar#scrub change->player-bar#seek"
                   class="absolute inset-0 h-full w-full cursor-pointer appearance-none bg-transparent
                          [&::-webkit-slider-thumb]:h-3 [&::-webkit-slider-thumb]:w-3
                          [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full
                          [&::-webkit-slider-thumb]:bg-lime-accent
                          [&::-moz-range-thumb]:h-3 [&::-moz-range-thumb]:w-3
                          [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:border-0
                          [&::-moz-range-thumb]:bg-lime-accent">
          </div>

          <span class="w-10 text-xs tabular-nums text-neutral-400"
                data-player-bar-target="total">0:00</span>
        </div>

        <div class="hidden flex-none items-center gap-2 lg:flex">
          <span aria-hidden="true" class="text-neutral-400">🔊</span>
          <input type="range" min="0" max="100" value="80"
                 aria-label="Volume"
                 data-player-bar-target="volume"
                 data-action="input->player-bar#setVolume"
                 class="h-1 w-24 cursor-pointer appearance-none rounded-full bg-white/10
                        [&::-webkit-slider-thumb]:h-3 [&::-webkit-slider-thumb]:w-3
                        [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-full
                        [&::-webkit-slider-thumb]:bg-neutral-300
                        [&::-moz-range-thumb]:h-3 [&::-moz-range-thumb]:w-3
                        [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:border-0
                        [&::-moz-range-thumb]:bg-neutral-300">
        </div>
      </div>
    </div>
  <% end %>
<% end %>
