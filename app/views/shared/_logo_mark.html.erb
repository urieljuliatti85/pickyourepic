<%# The app's mark: the logo's vinyl record, redrawn in SVG.
    The original PNG is raster and exists only in white; here the color comes from
    currentColor, so one file serves the nav on a light or dark background.
    `size` is a Tailwind dimension class; `detailed` turns on the grooves, which
    become a solid smudge below ~32px and are therefore left out of the nav. %>
<svg viewBox="0 0 48 48" fill="none" aria-hidden="true"
     class="<%= local_assigns.fetch(:size, "h-6 w-6") %>">
  <circle cx="24" cy="24" r="23" fill="currentColor"/>

  <% if local_assigns.fetch(:detailed, false) %>
    <g stroke="var(--color-ink)" stroke-opacity="0.28" fill="none">
      <circle cx="24" cy="24" r="19" stroke-width="1.1"/>
      <circle cx="24" cy="24" r="16" stroke-width="1.1"/>
      <circle cx="24" cy="24" r="13" stroke-width="1.1"/>
    </g>
  <% end %>

  <%# Center label and spindle hole. %>
  <circle cx="24" cy="24" r="8.5" fill="var(--color-ink)" fill-opacity="0.92"/>
  <circle cx="24" cy="24" r="1.9" fill="currentColor"/>
</svg>
