<%# An Epic's play button. It does not instantiate the SDK: it asks the global
    bar to play (shared/_player_bar), which is what holds the device.

    For anyone without Premium the bar does not exist, so the explanation stands
    here in the button's place — the SDK is the only playback route and it
    requires Premium (CLAUDE.md § Architecture — Playback). %>
<% if current_user&.spotify_account&.premium? %>
  <button type="button"
          class="inline-flex items-center gap-2 rounded-full bg-lime-accent px-4 py-2 text-sm font-semibold uppercase tracking-[0.12em] text-neutral-950 hover:bg-lime-bright"
          data-controller="play-request"
          data-play-request-uri-value="spotify:track:<%= epic.track.spotify_id %>"
          data-play-request-start-time-value="<%= epic.start_time %>"
          data-play-request-end-time-value="<%= epic.end_time %>"
          data-play-request-title-value="<%= epic.title %>"
          data-play-request-subtitle-value="<%= epic.track.artist_name %> · <%= epic.track.name %>"
          data-play-request-artwork-value="<%= epic.track.album_artwork_url %>"
          data-action="play-request#play">
    <span aria-hidden="true">▶</span> Play
  </button>
<% elsif current_user %>
  <p class="text-xs text-neutral-500">
    <em>Spotify Premium is required to play.</em>
  </p>
<% else %>
  <%# Signed out is not the same case as "no Premium": the old message
      blamed the subscription of someone who had not even signed in, and the
      page led nowhere. The SDK plays through the listener's own account, so
      signing in really is a prerequisite — but now there is a button for it. %>
  <%= button_to "Sign in to listen", auth_spotify_path,
        form: { data: { turbo: false } },
        class: "inline-flex items-center gap-2 rounded-full bg-lime-accent px-4 py-2 text-sm font-semibold text-neutral-950 hover:bg-lime-bright" %>

  <p class="mt-2 text-xs text-neutral-500">
    <em>Playback uses your own Spotify account and requires Premium.</em>
  </p>
<% end %>
