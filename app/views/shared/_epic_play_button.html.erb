<%# Botao de play de um Epic. Nao instancia o SDK: pede para a barra global
    tocar (shared/_player_bar), que e quem detem o device.

    Para quem nao tem Premium a barra nao existe, entao aqui fica a explicacao
    no lugar do botao — o SDK e a unica via de playback e exige Premium
    (CLAUDE.md § Architecture — Playback). %>
<% if current_user&.spotify_account&.premium? %>
  <button type="button"
          class="inline-flex items-center gap-2 rounded-full bg-lime-accent px-4 py-2 text-sm font-semibold text-neutral-950 hover:bg-lime-bright"
          data-controller="play-request"
          data-play-request-uri-value="spotify:track:<%= epic.track.spotify_id %>"
          data-play-request-start-time-value="<%= epic.start_time %>"
          data-play-request-end-time-value="<%= epic.end_time %>"
          data-play-request-title-value="<%= epic.title %>"
          data-play-request-subtitle-value="<%= epic.track.artist_name %> · <%= epic.track.name %>"
          data-play-request-artwork-value="<%= epic.track.album_artwork_url %>"
          data-action="play-request#play">
    <span aria-hidden="true">▶</span> Tocar
  </button>
<% elsif current_user %>
  <p class="text-xs text-neutral-500">
    <em>Spotify Premium é necessário para tocar.</em>
  </p>
<% else %>
  <%# Deslogado nao e o mesmo caso que "sem Premium": a mensagem antiga
      culpava a assinatura de quem nem tinha entrado, e a pagina ficava sem
      saida. O SDK toca pela conta do proprio ouvinte, entao entrar e mesmo
      um pre-requisito — mas agora ha o botao para isso. %>
  <%= button_to "Entrar para ouvir", auth_spotify_path,
        form: { data: { turbo: false } },
        class: "inline-flex items-center gap-2 rounded-full bg-lime-accent px-4 py-2 text-sm font-semibold text-neutral-950 hover:bg-lime-bright" %>

  <p class="mt-2 text-xs text-neutral-500">
    <em>A reprodução usa sua própria conta Spotify e requer Premium.</em>
  </p>
<% end %>
