<nav class="sticky top-0 z-20 border-b border-white/5 bg-ink/85 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center gap-6 px-4 py-3.5 sm:px-6">

    <%# The mark disappears once the sidebar shows: there it already sits atop the column. %>
    <%= link_to root_path, class: "flex shrink-0 items-center gap-2 text-sm font-bold tracking-tight lg:hidden" do %>
      <span class="text-lime-accent"><%= render "shared/logo_mark" %></span>
      Pick Up Your Epic!
    <% end %>

    <%# Tabs, like the reference's DISCOVER / MY LIBRARY / RADIO. The active tab
        gets the cyan underline. %>
    <div class="flex items-center gap-5 text-sm font-semibold uppercase tracking-wide">
      <% tab = ->(active) { active ? "border-b-2 border-lime-accent pb-1 text-neutral-100" : "pb-1 text-neutral-500 hover:text-neutral-200" } %>

      <%= link_to "Discover", discover_path, class: tab.call(current_page?(discover_path)) %>

      <%= link_to "Public Collections", public_collections_path, class: tab.call(current_page?(public_collections_path)) %>

      <% if signed_in? %>
        <%# Your own profile is already linked from the @handle on the right;
            two entries to the same page would only take up space. %>
        <%= link_to "Mine", collections_path, class: tab.call(current_page?(collections_path)) %>
      <% end %>
    </div>

    <% if signed_in? %>
      <%# Search at the top, as in the reference. It is still the real /tracks
          form: a plain GET, no JS. %>
      <%= form_with url: tracks_path, method: :get, class: "ml-auto hidden max-w-xs flex-1 sm:block" do |form| %>
        <%= form.search_field :q, value: params[:q],
              placeholder: "Search for a song…", autocomplete: "off",
              class: "w-full rounded-full border border-white/10 bg-white/5 px-4 py-1.5 text-sm placeholder:text-neutral-500 focus:border-lime-accent focus:outline-none" %>
      <% end %>
    <% end %>

    <div class="ml-auto flex shrink-0 items-center gap-3 text-sm sm:ml-0">
      <% if signed_in? %>
        <%= link_to "@#{current_user.username}", profile_path(current_user),
              class: "rounded-full bg-white/5 px-3 py-1.5 font-medium text-neutral-100 hover:bg-lime-accent hover:text-neutral-950" %>

        <%# The sign out route existed from the start, but no screen linked to
            it — whoever signed in had no way out. %>
        <%= button_to "Sign out", sign_out_path, method: :delete,
              class: "text-neutral-500 underline underline-offset-4 hover:text-neutral-300" %>
      <% else %>
        <%= button_to "Sign in", auth_spotify_path,
              form: { data: { turbo: false } },
              class: "rounded-full bg-lime-accent px-4 py-1.5 font-semibold text-neutral-950 hover:bg-lime-bright" %>
      <% end %>
    </div>
  </div>
</nav>
