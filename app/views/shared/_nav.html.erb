<nav class="top-bar sticky top-0 z-20">
  <div class="mx-auto flex max-w-7xl items-center gap-6 px-4 py-3.5 sm:px-6">

    <%# The mark disappears once the sidebar shows: there it already sits atop the column. %>
    <%= link_to root_path, class: "flex shrink-0 items-center gap-2 text-sm font-bold tracking-tight text-white lg:hidden" do %>
      <span class="text-white"><%= render "shared/logo_mark" %></span>
      Pick Up Your Epic!
    <% end %>

    <%# Tabs, like the reference's DISCOVER / MY LIBRARY / RADIO: wide letter
        spacing, generous gaps, and the active one in white over a cyan rule
        that sits clear of the text. The inactive ones stay legible rather than
        receding — in the reference they read as available, not disabled.

        `whitespace-nowrap` because "Public Collections" is two words and would
        otherwise wrap into two lines inside its own tab. %>
    <div class="flex items-center gap-6 text-sm font-semibold uppercase tracking-[0.12em] sm:gap-9">
      <%# White at two strengths rather than the app's greys: those were picked
          against the dark ink and turn muddy on this lighter ground. %>
      <% tab = ->(active) { "whitespace-nowrap pb-1.5 #{active ? "border-b-2 border-lime-bright text-white" : "text-white/65 hover:text-white"}" } %>

      <%= link_to "Discover", discover_path, class: tab.call(current_page?(discover_path)) %>

      <%= link_to "Public Collections", public_collections_path, class: tab.call(current_page?(public_collections_path)) %>

      <% if signed_in? %>
        <%# Your own profile is already linked from the @handle on the right;
            two entries to the same page would only take up space. %>
        <%= link_to "Mine", collections_path, class: tab.call(current_page?(collections_path)) %>
      <% end %>
    </div>

    <% if signed_in? %>
      <%# Search at the top, as in the reference. It is still the real /tracks
          form: a plain GET, no JS. %>
      <%= form_with url: tracks_path, method: :get, class: "ml-auto hidden max-w-xs flex-1 sm:block" do |form| %>
        <%= form.search_field :q, value: params[:q],
              placeholder: "Search for a song…", autocomplete: "off",
              class: "w-full rounded-full border border-white/25 bg-white/10 px-4 py-1.5 text-sm text-white placeholder:text-white/60 focus:border-white focus:outline-none" %>
      <% end %>
    <% end %>

    <div class="ml-auto flex shrink-0 items-center gap-3 text-sm sm:ml-0">
      <% if signed_in? %>
        <%= link_to "@#{current_user.username}", profile_path(current_user),
              class: "rounded-full bg-white/15 px-3 py-1.5 font-medium text-white hover:bg-white hover:text-neutral-900" %>

        <%# The sign out route existed from the start, but no screen linked to
            it — whoever signed in had no way out. %>
        <%= button_to "Sign out", sign_out_path, method: :delete,
              class: "whitespace-nowrap text-white underline underline-offset-4 hover:text-white/80" %>
      <% else %>
        <%= button_to "Sign in", auth_spotify_path,
              form: { data: { turbo: false } },
              class: "rounded-full bg-white px-4 py-1.5 font-semibold uppercase tracking-[0.12em] text-neutral-900 hover:bg-white/90" %>
      <% end %>
    </div>
  </div>
</nav>
