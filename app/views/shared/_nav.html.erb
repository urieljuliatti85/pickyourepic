<nav class="sticky top-0 z-10 border-b border-white/5 bg-ink/85 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-3.5">
    <%= link_to root_path, class: "flex items-center gap-2 text-sm font-bold tracking-tight" do %>
      <span class="text-lime-accent"><%= render "shared/logo_mark" %></span>
      Pick Up Your Epic!
    <% end %>

    <div class="flex items-center gap-5 text-sm">
      <%# Discover e publico; o resto exige sessao. %>
      <%= link_to "Discover", discover_path, class: "text-neutral-400 hover:text-neutral-100" %>

      <% if signed_in? %>
        <%= link_to "Search", tracks_path, class: "text-neutral-400 hover:text-neutral-100" %>
        <%= link_to "Collections", collections_path, class: "text-neutral-400 hover:text-neutral-100" %>
        <%# Antes apontava para root_path, entao o proprio perfil nao tinha link. %>
        <%= link_to "@#{current_user.username}", profile_path(current_user),
              class: "rounded-full bg-white/5 px-3 py-1.5 font-medium text-neutral-100 hover:bg-lime-accent hover:text-neutral-950" %>

        <%# A rota de sign out existia desde o inicio, mas nenhuma tela linkava
            para ela — quem entrava nao tinha como sair. %>
        <%= button_to "Sair", sign_out_path, method: :delete,
              class: "text-neutral-500 underline underline-offset-4 hover:text-neutral-300" %>
      <% else %>
        <%= button_to "Entrar", auth_spotify_path,
              form: { data: { turbo: false } },
              class: "rounded-full bg-lime-accent px-4 py-1.5 font-semibold text-neutral-950 hover:bg-lime-bright" %>
      <% end %>
    </div>
  </div>
</nav>
