<nav class="border-b border-neutral-800 bg-neutral-950/90 backdrop-blur sticky top-0 z-10">
  <div class="mx-auto flex max-w-2xl items-center justify-between px-5 py-3">
    <%= link_to root_path, class: "text-sm font-bold tracking-tight" do %>
      Pick Up Your Epic!
    <% end %>

    <div class="flex items-center gap-4 text-sm">
      <%# Discover e publico; o resto exige sessao. %>
      <%= link_to "Discover", discover_path, class: "text-neutral-400 hover:text-neutral-100" %>

      <% if signed_in? %>
        <%= link_to "Search", tracks_path, class: "text-neutral-400 hover:text-neutral-100" %>
        <%= link_to "Collections", collections_path, class: "text-neutral-400 hover:text-neutral-100" %>
        <%# Antes apontava para root_path, entao o proprio perfil nao tinha link. %>
        <%= link_to "@#{current_user.username}", profile_path(current_user),
              class: "text-neutral-100 hover:text-emerald-400" %>
      <% end %>
    </div>
  </div>
</nav>
