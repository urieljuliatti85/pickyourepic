<% content_for :title, "Playlists — Pick Up Your Epic!" %>

<div class="mx-auto max-w-4xl px-5 py-8">

  <h1 class="text-2xl font-bold tracking-tight">
    Public <span class="text-lime-accent">playlists.</span>
  </h1>
  <p class="mt-2 text-sm text-neutral-400">
    Search Spotify's public playlists, open one, and turn a song into an Epic.
  </p>

  <%# The frame means typing swaps only the result list; search_controller
      debounces so a twelve-letter term is not twelve round trips. Without JS the
      form still submits and returns the same page. %>
  <%= form_with url: playlists_path, method: :get,
        data: { turbo_frame: "playlist_results", controller: "search",
                action: "input->search#submit" },
        class: "mt-6" do |form| %>
    <%= form.search_field :q, value: @query,
          placeholder: "rock, sad songs, 90s, workout…",
          autofocus: true, autocomplete: "off",
          class: "w-full rounded-full border border-neutral-800 bg-neutral-900 px-5 py-3 text-base placeholder:text-neutral-600 focus:border-lime-accent focus:outline-none" %>
  <% end %>

  <%= turbo_frame_tag "playlist_results", class: "mt-8 block" do %>
    <%= render "playlists/results", playlists: @playlists, query: @query %>
  <% end %>
</div>
