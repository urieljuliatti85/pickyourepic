<% content_for :title, "Discover — Pick Up Your Epic!" %>

<div class="mx-auto max-w-7xl px-4 py-6 sm:px-6">

  <%# O h1 e da pagina, nao do hero: o titulo do Epic em destaque muda a cada
      visita, e a pagina precisa de um cabecalho estavel. %>
  <h1 class="text-2xl font-bold tracking-tight">
    Discover <span class="text-lime-accent">Epics.</span>
  </h1>
  <p class="mt-1 text-sm text-neutral-400">Os momentos mais pickados primeiro.</p>

  <% if @epics.any? %>
    <%# Hero: o Epic mais pickado, como o bloco "Flume: Skin" da referencia. %>
    <% featured = @epics.first %>
    <section class="hero-glow mt-6 overflow-hidden rounded-3xl px-6 py-10 sm:px-10 sm:py-14">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-lime-accent">
        Mais pickado
      </p>

      <h2 class="mt-3 max-w-2xl text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
        <%= featured.title %>
      </h2>

      <p class="mt-3 max-w-xl text-neutral-300">
        <strong class="font-medium"><%= featured.track.name %></strong>
        <span class="text-neutral-400">· <%= featured.track.artist_name %></span>
      </p>

      <p class="mt-1 text-sm text-neutral-400">
        <%= number_to_duration(featured.start_time) %> – <%= number_to_duration(featured.end_time) %>
        · <%= pluralize(featured.picks.count, "Pick") %>
        · por <%= link_to featured.user.username, profile_path(featured.user), class: "text-neutral-200 hover:text-lime-accent" %>
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <%= render "shared/epic_play_button", epic: featured %>
        <%= render "shared/pick_button", epic: featured %>
      </div>
    </section>

    <%# Linha horizontal, como "Popular Albums". %>
    <% rest = @epics.drop(1) %>
    <% if rest.any? %>
      <section class="mt-12">
        <h2 class="text-2xl font-bold tracking-tight">Epics em alta</h2>

        <div class="rail mt-5 pb-2">
          <% rest.each do |epic| %>
            <article class="card-dark w-56 rounded-2xl p-4">
              <% if epic.track.album_artwork_url.present? %>
                <%= image_tag epic.track.album_artwork_url, alt: "",
                      class: "mb-3 aspect-square w-full rounded-xl object-cover" %>
              <% else %>
                <div class="mb-3 aspect-square w-full rounded-xl bg-white/5"></div>
              <% end %>

              <h3 class="truncate text-sm font-semibold">
                <%= link_to epic.title, epic_path(epic), class: "hover:text-lime-accent" %>
              </h3>
              <p class="mt-0.5 truncate text-xs text-neutral-400">
                <%= epic.track.artist_name %>
              </p>
              <p class="mt-2 text-xs text-neutral-500">
                <%= number_to_duration(epic.start_time) %> – <%= number_to_duration(epic.end_time) %>
                · <%= pluralize(epic.picks.count, "Pick") %>
              </p>

              <div class="mt-3 flex items-center gap-2">
                <%= render "shared/epic_play_button", epic: epic %>
              </div>

              <div class="mt-2">
                <%= render "shared/pick_button", epic: epic %>
              </div>
            </article>
          <% end %>
        </div>
      </section>
    <% end %>
  <% else %>
    <div class="card-dark mt-10 rounded-2xl p-10 text-center">
      <p class="text-neutral-400">No public Epics yet. Be the first to create one!</p>
      <% if signed_in? %>
        <%= link_to "Buscar música", tracks_path,
              class: "mt-5 inline-block rounded-full bg-lime-accent px-5 py-2.5 text-sm font-semibold text-neutral-950 hover:bg-lime-bright" %>
      <% end %>
    </div>
  <% end %>
</div>
