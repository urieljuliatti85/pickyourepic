<% content_for :title, "Discover — Pick Up Your Epic!" %>

<div class="mx-auto max-w-5xl px-6 py-12">
  <h1 class="text-4xl font-bold tracking-tight">
    Discover <span class="text-lime-accent">Epics.</span>
  </h1>
  <p class="mt-3 text-neutral-400">Os momentos mais pickados primeiro.</p>

  <% if @epics.any? %>
    <div class="mt-10 grid gap-4">
      <% @epics.each do |epic| %>
        <div class="card-dark rounded-2xl p-5">
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
              <h2 class="text-lg font-semibold">
                <%= link_to epic.title, epic_path(epic), class: "hover:text-lime-accent" %>
              </h2>

              <p class="mt-1 text-sm text-neutral-300">
                <strong class="font-medium"><%= epic.track.name %></strong>
                <span class="text-neutral-500">· <%= epic.track.artist_name %></span>
              </p>

              <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-neutral-500">
                <span class="rounded-full bg-white/5 px-2 py-0.5 font-medium text-neutral-300">
                  <%= number_to_duration(epic.start_time) %> – <%= number_to_duration(epic.end_time) %>
                </span>
                <span>
                  por <%= link_to epic.user.username, profile_path(epic.user), class: "text-neutral-300 hover:text-lime-accent" %>
                </span>
                <span>· <%= pluralize(epic.picks.count, "Pick") %></span>
              </p>

              <div class="mt-3">
                <%= render "shared/epic_player", epic: epic %>
              </div>
            </div>

            <div class="shrink-0">
              <% if current_user && current_user.id != epic.user_id && !current_user.picks.exists?(epic_id: epic.id) %>
                <%= button_to "Pick",
                    epic_pick_path(epic),
                    method: :post,
                    class: "rounded-full bg-lime-accent px-4 py-2 text-sm font-semibold text-neutral-950 hover:bg-lime-bright" %>
              <% elsif current_user && current_user.picks.exists?(epic_id: epic.id) %>
                <%# O selo passa a ser acionavel: desfazer o Pick sem sair do Discover. %>
                <%= button_to "Picked ✓",
                    epic_pick_path(epic),
                    method: :delete,
                    class: "rounded-full border border-lime-accent/40 px-4 py-2 text-sm font-semibold text-lime-accent hover:bg-lime-accent/10" %>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="card-dark mt-10 rounded-2xl p-10 text-center">
      <p class="text-neutral-400">No public Epics yet. Be the first to create one!</p>
      <% if signed_in? %>
        <%= link_to "Buscar música", tracks_path,
              class: "mt-5 inline-block rounded-full bg-lime-accent px-5 py-2.5 text-sm font-semibold text-neutral-950 hover:bg-lime-bright" %>
      <% end %>
    </div>
  <% end %>
</div>
