<div class="max-w-4xl mx-auto p-4">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold">My Collections</h1>
    <%= link_to "New Collection", new_collection_path, class: "px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600" %>
  </div>

  <% if @collections.any? %>
    <div class="grid grid-cols-1 gap-4">
      <% @collections.each do |collection| %>
        <div class="p-4 border border-gray-300 rounded hover:shadow-md transition">
          <div class="flex items-center justify-between">
            <h2 class="font-semibold text-lg">
              <%= link_to collection.title, collection_path(collection), class: "text-blue-600 hover:underline" %>
            </h2>
            <% if collection.visibility_public? %>
              <span class="px-2 py-1 bg-green-100 text-green-800 rounded text-xs">Public</span>
            <% else %>
              <span class="px-2 py-1 bg-gray-300 text-gray-800 rounded text-xs">Private</span>
            <% end %>
          </div>
          <% if collection.description.present? %>
            <p class="text-sm text-gray-600 mt-1"><%= collection.description %></p>
          <% end %>
          <p class="text-xs text-gray-500 mt-2">
            <%= pluralize(collection.epics.count, "Epic") %>
          </p>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-600">No collections yet. Create your first one!</p>
  <% end %>
</div>
