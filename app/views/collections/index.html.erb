<%# Layout da referencia: hero em degrade com titulo grande e botoes em
    pilula, e abaixo uma rail horizontal de capas com titulo/subtitulo.
    `hero-glow`, `rail` e `card-dark` ja existem (application.css) e sao os
    mesmos que a Discover usa — a ideia e as duas telas parecerem a mesma app. %>
<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6">

  <section class="hero-glow overflow-hidden rounded-3xl border border-white/10 px-6 py-10 sm:px-10 sm:py-14">
    <h1 class="text-3xl font-bold tracking-tight text-neutral-50 sm:text-5xl">
      My Collections
    </h1>

    <p class="mt-3 max-w-lg text-sm leading-relaxed text-neutral-300 sm:text-base">
      Seus Epics agrupados do seu jeito — os que você criou e os que você pickou.
    </p>

    <div class="mt-7 flex flex-wrap items-center gap-3">
      <%= link_to "Nova Collection", new_collection_path,
            class: "rounded-full bg-lime-accent px-8 py-2.5 text-sm font-semibold uppercase tracking-wide text-neutral-950 hover:bg-lime-bright" %>

      <%= link_to "Discover", discover_path,
            class: "rounded-full border border-lime-accent/60 px-8 py-2.5 text-sm font-semibold uppercase tracking-wide text-lime-accent hover:bg-lime-accent/10" %>
    </div>
  </section>

  <% if @collections.any? %>
    <section class="mt-12">
      <h2 class="text-2xl font-bold tracking-tight">Suas Collections</h2>

      <%# Rail horizontal, como "Popular Albums" da referencia. %>
      <div class="rail mt-5 pb-2">
        <% @collections.each do |collection| %>
          <article class="card-dark w-56 rounded-2xl p-4">
            <%= link_to collection_path(collection), class: "block" do %>
              <%# A capa da Collection e a do primeiro Epic: ela nao tem imagem
                  propria, e o Epic aponta para uma Track que tem. %>
              <%# `.first` na associacao ja carregada (o controller faz o
                  includes); `epics.includes(...)` aqui dispararia uma query
                  nova por card, anulando o preload. %>
              <% cover = collection.epics.first&.track&.album_artwork_url %>

              <% if cover.present? %>
                <%= image_tag cover, alt: "", loading: "lazy",
                      class: "mb-3 aspect-square w-full rounded-xl object-cover" %>
              <% else %>
                <div class="mb-3 flex aspect-square w-full items-center justify-center rounded-xl bg-white/5 text-2xl text-neutral-700">
                  ♪
                </div>
              <% end %>

              <h3 class="truncate text-sm font-semibold text-neutral-100 hover:text-lime-accent">
                <%= collection.title %>
              </h3>
            <% end %>

            <p class="mt-0.5 truncate text-xs text-neutral-400">
              <%= pluralize(collection.epics.size, "Epic") %>
              <% unless collection.visibility_public? %>
                · <span class="text-neutral-500">Private</span>
              <% end %>
            </p>
          </article>
        <% end %>
      </div>
    </section>
  <% else %>
    <section class="mt-12 rounded-3xl border border-white/10 bg-ink-soft p-10 text-center">
      <p class="text-sm text-neutral-400">
        Você ainda não tem Collections. Crie a primeira e agrupe seus Epics.
      </p>
    </section>
  <% end %>
</div>
