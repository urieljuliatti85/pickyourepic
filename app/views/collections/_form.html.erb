<%# The same fields and pills as the Epic form, so the two creation screens
    look like the same app. %>
<%= form_with(model: collection) do |form| %>
  <% if collection.errors.any? %>
    <div class="mb-6 rounded-2xl border border-red-500/30 bg-red-500/10 p-4 text-red-200">
      <h3 class="text-sm font-semibold">
        <%= pluralize(collection.errors.count, "erro") %> impediu esta Collection de ser salva:
      </h3>
      <ul class="mt-2 list-inside list-disc text-sm">
        <% collection.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% field = "mt-1.5 w-full rounded-2xl border border-white/10 bg-white/5 px-4 py-2.5 text-sm text-neutral-100 placeholder:text-neutral-500 focus:border-lime-accent focus:outline-none" %>
  <% label = "text-xs font-semibold uppercase tracking-[0.12em]r text-neutral-400" %>

  <div class="mb-5">
    <%= form.label :title, "Title", class: label %>
    <%= form.text_field :title, required: true, class: field %>
  </div>

  <div class="mb-5">
    <%= form.label :description, "Description (optional)", class: label %>
    <%= form.text_area :description, rows: 3, class: field %>
  </div>

  <div class="mb-8">
    <span class="<%= label %>">Visibilidade</span>

    <div class="mt-2 flex flex-wrap gap-2">
      <label class="flex cursor-pointer items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-neutral-300 hover:border-lime-accent/50 has-[:checked]:border-lime-accent has-[:checked]:text-neutral-50">
        <%= form.radio_button :visibility, "public", class: "accent-lime-accent",
              checked: collection.visibility_public? || collection.new_record? %>
        Public
      </label>

      <label class="flex cursor-pointer items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-neutral-300 hover:border-lime-accent/50 has-[:checked]:border-lime-accent has-[:checked]:text-neutral-50">
        <%= form.radio_button :visibility, "private", class: "accent-lime-accent",
              checked: collection.visibility_private? %>
        Private
      </label>
    </div>
  </div>

  <%= form.submit class: "cursor-pointer rounded-full bg-lime-accent px-8 py-2.5 text-sm font-semibold uppercase tracking-[0.12em] text-neutral-950 hover:bg-lime-bright" %>
<% end %>
