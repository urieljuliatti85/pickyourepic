<%= form_with(model: collection, class: "space-y-4") do |form| %>
  <% if collection.errors.any? %>
    <div class="p-4 bg-red-100 text-red-800 rounded">
      <h3 class="font-bold">Errors:</h3>
      <ul class="list-disc pl-4">
        <% collection.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :title, class: "mt-1 block w-full rounded border-gray-300 shadow-sm", required: true %>
  </div>

  <div>
    <%= form.label :description, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_area :description, class: "mt-1 block w-full rounded border-gray-300 shadow-sm", rows: 3 %>
  </div>

  <div>
    <span class="block text-sm font-medium text-gray-700 mb-2">Visibility</span>
    <div class="flex gap-4">
      <label class="flex items-center gap-2">
        <%= form.radio_button :visibility, "public", checked: collection.visibility_public? || collection.new_record? %>
        <span class="text-sm">Public</span>
      </label>
      <label class="flex items-center gap-2">
        <%= form.radio_button :visibility, "private", checked: collection.visibility_private? %>
        <span class="text-sm">Private</span>
      </label>
    </div>
  </div>

  <div>
    <%= form.submit class: "px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600 cursor-pointer" %>
  </div>
<% end %>
