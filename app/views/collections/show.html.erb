<%# The same layout as the index and the reference: a gradient hero with a large
    title and pill buttons, and the artwork rail below. %>
<div class="mx-auto max-w-7xl px-4 py-8 sm:px-6">

  <%# A visitor must not see the owner's private Epics through a public
      Collection; the owner still sees all of theirs
      (Collection#collection_epics_visible_to). %>
  <% epics = @collection.collection_epics_visible_to(current_user) %>

  <section class="hero-glow overflow-hidden rounded-3xl border border-white/10 px-6 py-10 sm:px-10 sm:py-14">
    <h1 class="text-3xl font-bold tracking-tight text-neutral-50 sm:text-5xl">
      <%= @collection.title %>
    </h1>

    <p class="mt-3 text-sm text-neutral-300">
      <%= link_to "@#{@collection.user.username}", profile_path(@collection.user),
            class: "font-medium hover:text-lime-accent" %>
      · <%= pluralize(epics.size, "Epic") %>
    </p>

    <%# The badge is always visible: whether a Collection is public matters
        as much to its owner as to a visitor. %>
    <p class="mt-3">
      <% if @collection.visibility_public? %>
        <span class="rounded-full bg-lime-accent/15 px-3 py-1 text-xs font-semibold text-lime-accent">Public</span>
      <% else %>
        <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-neutral-300">Private</span>
      <% end %>
    </p>

    <% if @collection.description.present? %>
      <p class="mt-2 max-w-lg text-sm leading-relaxed text-neutral-400">
        <%= @collection.description %>
      </p>
    <% end %>

    <%# Play and the owner's actions, in place of the reference's PLAY / FOLLOW. %>
    <div class="mt-7 flex flex-wrap items-center gap-3">
      <%= render "shared/collection_player", collection: @collection %>

      <% if current_user == @collection.user %>
        <%= link_to "Edit", edit_collection_path(@collection),
              class: "rounded-full border border-lime-accent/60 px-8 py-2.5 text-sm font-semibold uppercase tracking-[0.12em] text-lime-accent hover:bg-lime-accent/10" %>

        <%= button_to "Delete", collection_path(@collection), method: :delete,
              form: { class: "inline-block" },
              data: { turbo_confirm: "Are you sure?" },
              class: "rounded-full border border-red-500/40 px-8 py-2.5 text-sm font-semibold uppercase tracking-[0.12em] text-red-300 hover:bg-red-500/10" %>
      <% end %>
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-2xl font-bold tracking-tight">Epics</h2>

    <% if epics.any? %>
      <div class="rail mt-5 pb-2">
        <% epics.each do |ce| %>
          <article class="card-dark w-56 rounded-2xl p-4">
            <%= link_to epic_path(ce.epic), class: "block" do %>
              <% cover = ce.epic.track.album_artwork_url %>

              <% if cover.present? %>
                <%= image_tag cover, alt: "", loading: "lazy",
                      class: "mb-3 aspect-square w-full rounded-xl object-cover" %>
              <% else %>
                <div class="mb-3 flex aspect-square w-full items-center justify-center rounded-xl bg-white/5 text-2xl text-neutral-700">
                  ♪
                </div>
              <% end %>

              <h3 class="truncate text-sm font-semibold text-neutral-100 hover:text-lime-accent">
                <%= ce.epic.title %>
              </h3>
            <% end %>

            <p class="mt-0.5 truncate text-xs text-neutral-400">
              <%= ce.epic.track.name %> · <%= ce.epic.track.artist_name %>
            </p>

            <p class="mt-1 truncate text-xs tabular-nums text-neutral-500">
              <%= number_to_duration(ce.epic.start_time) %>–<%= number_to_duration(ce.epic.end_time) %>
              · <%= render "shared/pick_count", epic: ce.epic %>
            </p>

            <%# An Epic in the Collection may belong to someone else; the partial
                hides itself when it is the user's own. %>
            <div class="mt-3">
              <%= render "shared/pick_button", epic: ce.epic, compact: true %>
            </div>

            <% if current_user == @collection.user %>
              <%= button_to "Remove", collection_collection_epic_path(@collection, ce),
                    method: :delete,
                    class: "mt-2 w-full rounded-full border border-white/10 px-3 py-1.5 text-xs font-semibold text-neutral-400 hover:border-red-500/40 hover:text-red-300" %>
            <% end %>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="mt-5 rounded-3xl border border-white/10 bg-ink-soft p-10 text-center">
        <p class="text-sm text-neutral-400">No Epics in this Collection yet.</p>
      </div>
    <% end %>
  </section>

  <% if current_user == @collection.user %>
    <section class="mt-8 rounded-3xl border border-white/10 bg-ink-soft p-6 sm:p-8">
      <h3 class="text-xs font-semibold uppercase tracking-[0.12em]r text-neutral-400">Add Epic</h3>

      <%# This field used to ask for the Epic's numeric id; the search now
          resolves it by Epic title, song or artist. %>
      <p class="mt-3">
        <%= link_to "Search for an Epic", new_collection_collection_epic_path(@collection),
              class: "inline-block rounded-full bg-lime-accent px-8 py-2 text-sm font-semibold uppercase tracking-[0.12em] text-neutral-950 hover:bg-lime-bright" %>
      </p>
    </section>
  <% end %>

  <div class="mt-8">
    <%= link_to "Back", collections_path,
          class: "rounded-full border border-lime-accent/60 px-8 py-2.5 text-sm font-semibold uppercase tracking-[0.12em] text-lime-accent hover:bg-lime-accent/10" %>
  </div>
</div>
