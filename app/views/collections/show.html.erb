<div class="max-w-4xl mx-auto p-4">
  <!-- Collection Header -->
  <div class="mb-6 p-4 bg-gray-100 rounded">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-bold"><%= @collection.title %></h1>
        <p class="text-sm text-gray-600 mt-1">
          By <strong><%= @collection.user.username %></strong>
        </p>
      </div>
      <div>
        <% if @collection.visibility_public? %>
          <span class="px-2 py-1 bg-green-100 text-green-800 rounded text-xs">Public</span>
        <% else %>
          <span class="px-2 py-1 bg-gray-300 text-gray-800 rounded text-xs">Private</span>
        <% end %>
      </div>
    </div>
    <% if @collection.description.present? %>
      <p class="text-sm mt-2"><%= @collection.description %></p>
    <% end %>
  </div>

  <!-- Owner Actions -->
  <% if current_user == @collection.user %>
    <div class="mb-4 flex gap-2">
      <%= link_to "Edit", edit_collection_path(@collection), class: "px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue-600" %>
      <%= button_to "Delete", collection_path(@collection), method: :delete,
          class: "px-4 py-2 bg-red-500 text-white rounded hover:bg-red-600",
          data: { turbo_confirm: "Are you sure?" } %>
    </div>
  <% end %>

  <!-- Collection Player -->
  <div class="mb-6">
    <%= render "shared/collection_player", collection: @collection %>
  </div>

  <!-- Epics in Collection -->
  <div class="mb-8">
    <h2 class="text-xl font-bold mb-4">Epics (<%= @collection.epics.count %>)</h2>

    <% if @collection.collection_epics.any? %>
      <div class="grid grid-cols-1 gap-4">
        <% @collection.collection_epics.includes(epic: [:track, :user]).each do |ce| %>
          <div class="p-4 border border-gray-300 rounded hover:shadow-md transition flex items-center justify-between">
            <div>
              <h3 class="font-semibold text-lg">
                <%= link_to ce.epic.title, epic_path(ce.epic), class: "text-blue-600 hover:underline" %>
              </h3>
              <p class="text-sm text-gray-600 mt-1">
                <strong><%= ce.epic.track.name %></strong> by <%= ce.epic.track.artist_name %>
              </p>
              <p class="text-sm text-gray-600">
                Interval: <%= number_to_duration(ce.epic.start_time) %> - <%= number_to_duration(ce.epic.end_time) %>
              </p>
              <p class="text-xs text-gray-500 mt-1">
                By <%= ce.epic.user.username %> · <%= pluralize(ce.epic.picks.count, "Pick") %>
              </p>
            </div>
            <% if current_user == @collection.user %>
              <%= button_to "Remove",
                  collection_collection_epic_path(@collection, ce),
                  method: :delete,
                  class: "px-3 py-1 bg-red-100 text-red-800 rounded text-sm hover:bg-red-200" %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-600">No Epics in this collection yet.</p>
    <% end %>
  </div>

  <!-- Add Epic (owner only) -->
  <% if current_user == @collection.user %>
    <div class="mb-8 p-4 bg-blue-50 border border-blue-200 rounded">
      <h3 class="font-bold mb-2">Add Epic</h3>
      <%= form_with url: collection_collection_epics_path(@collection), method: :post, class: "flex gap-2" do |form| %>
        <%= form.number_field :epic_id, placeholder: "Epic ID", class: "flex-1 rounded border-gray-300 shadow-sm", required: true %>
        <%= form.submit "Add", class: "px-4 py-2 bg-green-500 text-white rounded hover:bg-green-600 cursor-pointer" %>
      <% end %>
    </div>
  <% end %>

  <!-- Back Link -->
  <div class="flex gap-2 mt-8">
    <%= link_to "Back to Collections", collections_path, class: "px-4 py-2 border border-gray-300 rounded hover:bg-gray-100" %>
  </div>
</div>
