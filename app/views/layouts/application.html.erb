<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Pick Up Your Epic!" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Pick Up Your Epic!">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-ink text-neutral-100 antialiased">
    <%# The web player shell: a sidebar fixed to the left (from lg up), content
        offset by lg:pl-64, and the player bar pinned to the bottom. %>

    <%# Toast notifications container. Used by Turbo Streams to append
        notifications without a page reload. %>
    <%# Where every toast is appended. The escaped quotes it was written with
        made the id literally `\"toasts-container\"`, so turbo_stream.append
        never found its target and no toast ever appeared. %>
    <div id="toasts-container" class="fixed top-4 right-4 z-50 space-y-2 max-w-sm"></div>

    <%= render "shared/sidebar" %>

    <div class="lg:pl-64">
      <%# Nav and flash in the layout: each was rendered by one isolated page, so
          the rest of the app had no navigation and no messages. %>
      <%= render "shared/nav" %>

      <%# pb-24 reserves room for the fixed bar, which would otherwise cover the end
          of the page. %>
      <main class="min-h-full pb-24">
        <%# id="flash" is the turbo_stream's target: an action over Turbo swaps
            only this block, without reloading the page. %>
        <div id="flash" class="max-w-4xl mx-auto px-4 pt-4">
          <%= render "shared/flash" %>
        </div>
        <%= yield %>
      </main>
    </div>

    <%= render "shared/player_bar" %>
  </body>
</html>
