<!DOCTYPE html>
<html class="h-full">
  <head>
    <title><%= content_for(:title) || "Pick Up Your Epic!" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Pick Up Your Epic!">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full bg-ink text-neutral-100 antialiased">
    <%# Shell do web player: sidebar fixa a esquerda (a partir de lg), conteudo
        deslocado por lg:pl-64, e a barra de player colada no rodape. %>
    <%= render "shared/sidebar" %>

    <div class="lg:pl-64">
      <%# Nav e flash no layout: cada um era renderizado por uma pagina isolada,
          entao o resto da app ficava sem navegacao e sem mensagens. %>
      <%= render "shared/nav" %>

      <%# pb-24 reserva o espaco da barra fixa, senao ela cobre o fim da pagina. %>
      <main class="min-h-full pb-24">
        <%# id="flash" e o alvo do turbo_stream: uma acao via Turbo troca so
            este bloco, sem recarregar a pagina. %>
        <div id="flash" class="max-w-4xl mx-auto px-4 pt-4">
          <%= render "shared/flash" %>
        </div>
        <%= yield %>
      </main>
    </div>

    <%= render "shared/player_bar" %>
  </body>
</html>
