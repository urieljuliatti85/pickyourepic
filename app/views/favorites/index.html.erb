<%# Favorites: the user's own private list. Reuses shared/_epic_row, the same
    row as the profile. %>
<div class="mx-auto max-w-4xl px-4 py-8 sm:px-6">

  <section class="hero-glow overflow-hidden rounded-3xl border border-white/10 px-6 py-10 sm:px-10">
    <h1 class="text-3xl font-bold tracking-tight text-neutral-50 sm:text-4xl">Favorites</h1>

    <p class="mt-3 max-w-lg text-sm leading-relaxed text-neutral-300">
      The Epics you saved. Only you can see this list.
    </p>
  </section>

  <section class="mt-10">
    <% if @epics.any? %>
      <ol class="space-y-0.5">
        <% @epics.each_with_index do |epic, index| %>
          <%# byline because the list mixes your Epics with other people's. %>
          <%= render "shared/epic_row", epic: epic, index: index, byline: true %>
        <% end %>
      </ol>
    <% else %>
      <%# Empty state: encourage discovering and saving Epics %>
      <%= render EmptyStateComponent.new(
        icon: "⭐",
        title: "No favorites yet",
        message: "Save your favorite Epics here. Explore Discover to find moments you love.",
        action_text: "Discover Epics",
        action_path: discover_path
      ) %>
    <% end %>
  </section>
</div>
