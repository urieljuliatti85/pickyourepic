<%# Perfil no formato da referencia: cabecalho com o avatar e, abaixo, listas
    numeradas de faixas (indice, capa, titulo sobre artista) em vez de cards.
    A linha e shared/_epic_row, reaproveitada pelas tres secoes. %>
<div class="mx-auto max-w-4xl px-4 py-8 sm:px-6">

  <section class="hero-glow overflow-hidden rounded-3xl border border-white/10 px-6 py-10 sm:px-10">
    <div class="flex flex-wrap items-center gap-5">
      <% if @user.avatar_url.present? %>
        <%= image_tag @user.avatar_url, alt: "",
              class: "h-20 w-20 flex-none rounded-full object-cover ring-2 ring-white/10 sm:h-24 sm:w-24" %>
      <% else %>
        <div class="flex h-20 w-20 flex-none items-center justify-center rounded-full bg-white/5 text-2xl font-bold text-neutral-600 ring-2 ring-white/10 sm:h-24 sm:w-24">
          <%= @user.username.first.upcase %>
        </div>
      <% end %>

      <div class="min-w-0">
        <h1 class="text-3xl font-bold tracking-tight text-neutral-50 sm:text-4xl">
          @<%= @user.username %>
        </h1>

        <p class="mt-2">
          <% if @user.visibility_public_profile? %>
            <span class="rounded-full bg-lime-accent/15 px-3 py-1 text-xs font-semibold text-lime-accent">
              Public Profile
            </span>
          <% else %>
            <span class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-neutral-300">
              Private Profile
            </span>
          <% end %>
        </p>

        <% if @user.bio.present? && !@is_private_profile %>
          <p class="mt-2 max-w-lg text-sm leading-relaxed text-neutral-400"><%= @user.bio %></p>
        <% end %>
      </div>
    </div>
  </section>

  <% if @is_private_profile %>
    <section class="mt-8 rounded-3xl border border-white/10 bg-ink-soft p-10 text-center">
      <p class="text-sm text-neutral-400">
        <strong class="text-neutral-200">This profile is private.</strong>
        Only the owner can see full details.
      </p>
    </section>
  <% else %>
    <section class="mt-10">
      <h2 class="text-2xl font-bold tracking-tight">Epics</h2>

      <% if @epics.any? %>
        <ol class="mt-4 space-y-0.5">
          <% @epics.each_with_index do |epic, index| %>
            <%= render "shared/epic_row", epic: epic, index: index %>
          <% end %>
        </ol>
      <% else %>
        <p class="mt-4 text-sm text-neutral-500">No public Epics yet.</p>
      <% end %>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-bold tracking-tight">Picked Epics</h2>

      <% if @picked_epics.any? %>
        <ol class="mt-4 space-y-0.5">
          <% @picked_epics.each_with_index do |epic, index| %>
            <%# byline: aqui o Epic e de outra pessoa, entao o autor importa. %>
            <%= render "shared/epic_row", epic: epic, index: index, byline: true %>
          <% end %>
        </ol>
      <% else %>
        <p class="mt-4 text-sm text-neutral-500">No picked Epics yet.</p>
      <% end %>
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-bold tracking-tight">Collections</h2>

      <% if @collections.any? %>
        <div class="rail mt-4 pb-2">
          <% @collections.each do |collection| %>
            <article class="card-dark w-56 rounded-2xl p-4">
              <%= link_to collection_path(collection), class: "block" do %>
                <% cover = collection.epics.first&.track&.album_artwork_url %>

                <% if cover.present? %>
                  <%= image_tag cover, alt: "", loading: "lazy",
                        class: "mb-3 aspect-square w-full rounded-xl object-cover" %>
                <% else %>
                  <div class="mb-3 flex aspect-square w-full items-center justify-center rounded-xl bg-white/5 text-2xl text-neutral-700">
                    ♪
                  </div>
                <% end %>

                <h3 class="truncate text-sm font-semibold text-neutral-100 hover:text-lime-accent">
                  <%= collection.title %>
                </h3>
              <% end %>

              <p class="mt-0.5 truncate text-xs text-neutral-400">
                <%= pluralize(collection.epics.size, "Epic") %>
              </p>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="mt-4 text-sm text-neutral-500">No public Collections yet.</p>
      <% end %>
    </section>
  <% end %>

  <div class="mt-10">
    <%= link_to "Back", root_path,
          class: "rounded-full border border-lime-accent/60 px-8 py-2.5 text-sm font-semibold uppercase tracking-wide text-lime-accent hover:bg-lime-accent/10" %>
  </div>
</div>
