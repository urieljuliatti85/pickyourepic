<%# Busca de Epics para adicionar a uma Collection. Substitui o campo que
    pedia o ID numerico do Epic — ninguem sabe o id de um Epic de cabeca. %>
<div class="mx-auto max-w-4xl px-4 py-8 sm:px-6">

  <section class="hero-glow overflow-hidden rounded-3xl border border-white/10 px-6 py-10 sm:px-10">
    <h1 class="text-3xl font-bold tracking-tight text-neutral-50 sm:text-4xl">
      Adicionar Epic
    </h1>
    <p class="mt-3 text-sm text-neutral-300">
      em <%= link_to @collection.title, collection_path(@collection),
                class: "font-semibold hover:text-lime-accent" %>
    </p>
  </section>

  <section class="mt-8">
    <%# `new` responde em turbo_stream, entao digitar troca so a lista.
        O debounce evita uma requisicao por tecla. %>
    <%= form_with url: new_collection_collection_epic_path(@collection),
          method: :get,
          data: { controller: "search", turbo_frame: "epic_search_results" } do |form| %>
      <%= form.search_field :q, value: @term, autofocus: true,
            placeholder: "Nome do Epic, da música ou da banda…",
            autocomplete: "off",
            data: { action: "input->search#submit" },
            class: "w-full rounded-full border border-white/10 bg-white/5 px-5 py-3 text-sm text-neutral-100 placeholder:text-neutral-500 focus:border-lime-accent focus:outline-none" %>

      <%# Sem JS o botao continua submetendo a busca. %>
      <noscript>
        <%= form.submit "Buscar",
              class: "mt-3 cursor-pointer rounded-full bg-lime-accent px-8 py-2 text-sm font-semibold uppercase tracking-wide text-neutral-950" %>
      </noscript>
    <% end %>

    <%= render "results", results: @results, term: @term, collection: @collection %>
  </section>

  <div class="mt-10">
    <%= link_to "Voltar", collection_path(@collection),
          class: "rounded-full border border-lime-accent/60 px-8 py-2.5 text-sm font-semibold uppercase tracking-wide text-lime-accent hover:bg-lime-accent/10" %>
  </div>
</div>
